page{background:#fffaf4;color:#352b26;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx}view,text,input,button{box-sizing:border-box}.page{padding:30rpx 30rpx 60rpx}.eyebrow{font-size:21rpx;letter-spacing:4rpx;color:#b48764}.heading{font-size:48rpx;font-weight:800;line-height:1.4;margin:12rpx 0}.muted{font-size:24rpx;color:#95877e;line-height:1.8}.notice{padding:18rpx 24rpx;background:#fff0d4;color:#94703c;border-radius:18rpx;font-size:22rpx;line-height:1.6;margin:20rpx 0}.card{background:#fff;border:1rpx solid #f1e7dc;border-radius:30rpx;padding:30rpx;margin:24rpx 0}.row{display:flex;align-items:center;justify-content:space-between;gap:14rpx}.title{font-size:32rpx;font-weight:700}.section-title{font-size:32rpx;font-weight:700;margin:32rpx 0 20rpx}.hero{background:linear-gradient(120deg,#f88350,#ee5c40);color:#fff;border-radius:34rpx;padding:38rpx;position:relative;overflow:hidden}.hero .muted{color:#ffe0cd}.hero .eyebrow{color:#ffdec4}.balance{font-size:76rpx;font-weight:800;margin:16rpx 0 8rpx}.pill{display:inline-block;font-size:21rpx;border-radius:100rpx;padding:8rpx 18rpx;background:#fff3e6;color:#bb7035}.hero .pill{background:#ffffff28;color:#fff}.button{background:#ee6741;color:#fff;border:0;border-radius:20rpx;font-size:27rpx;font-weight:600;margin:20rpx 0 0;padding:0 24rpx;line-height:84rpx}.button::after{border:0}.button[disabled]{background:#e5ddd4;color:#8f8176}.button.light{background:#fff1e4;color:#ba633c}.button.secondary{background:#f4f0e9;color:#77665a}.button.small{line-height:64rpx;font-size:24rpx;margin:0;white-space:nowrap}.stats{display:flex;gap:18rpx;margin:24rpx 0}.stat{flex:1;padding:24rpx;background:#fff;border:1rpx solid #f1e7dc;border-radius:24rpx}.stat-value{font-size:36rpx;font-weight:750;margin-bottom:6rpx}.week{display:flex;justify-content:space-between;margin:30rpx 0}.day{text-align:center;color:#a4978b;font-size:21rpx}.day-coin{border-radius:50%;width:62rpx;height:62rpx;background:#fff5e6;color:#cf9550;line-height:62rpx;font-size:27rpx;margin-bottom:12rpx}.day-coin.active{background:#f9ac55;color:white}.plan{display:flex;gap:20rpx;align-items:center;padding:22rpx 0;border-bottom:1rpx solid #f4eee7}.plan:last-child{border:0}.check{width:38rpx;height:38rpx;line-height:34rpx;text-align:center;border:2rpx solid #dfd4c8;border-radius:12rpx;color:white;flex-shrink:0}.check.done{background:#82a78e;border-color:#82a78e}.plan-text{flex:1}.plan-text.done{text-decoration:line-through;color:#aaa}.delete{font-size:30rpx;color:#baaaa0;padding:8rpx}.plan-input{background:#f8f5ef;border-radius:16rpx;padding:22rpx;height:80rpx;font-size:26rpx;margin-top:20rpx}.chest-stage{text-align:center;padding:35rpx 0;background:radial-gradient(ellipse,#fff0d5,transparent 70%)}.envelope{margin:20rpx auto;width:240rpx;height:230rpx;border-radius:28rpx;background:linear-gradient(140deg,#f58551,#e85439);box-shadow:0 24rpx 50rpx #ed714d30;display:flex;align-items:center;justify-content:center;transform:rotate(-5deg)}.seal{background:#ffd28a;color:#b57131;border:10rpx solid #ffbd64;width:114rpx;height:114rpx;line-height:94rpx;border-radius:50%;font-size:52rpx;font-weight:800;transform:rotate(5deg)}.timer{font-size:66rpx;font-weight:750;letter-spacing:8rpx;margin:16rpx 0}.reward{font-size:44rpx;font-weight:800;color:#d97640}.progress{height:12rpx;background:#f7e9d6;border-radius:30rpx;overflow:hidden;margin:22rpx 0}.progress-bar{height:100%;background:linear-gradient(90deg,#f4bc65,#eb7449);border-radius:30rpx}.lavender{background:#f4f0fc;border-color:#e7def6}.list-item{padding:24rpx 0;border-bottom:1rpx solid #f4eee7}.list-item:last-child{border:0}.amount{font-size:31rpx;font-weight:700;color:#789b72}.amount.minus{color:#c37454}.tabs{display:flex;gap:16rpx}.tab{flex:1;text-align:center;background:#fff;border:1rpx solid #eadfce;border-radius:16rpx;padding:20rpx}.tab.active{color:#d7663d;background:#fff0de;border-color:#e9a16a}.avatar{width:100rpx;height:100rpx;background:#ffe7b6;color:#bd7c34;border-radius:30rpx;font-size:52rpx;text-align:center;line-height:100rpx}.profile-row{padding:28rpx 0;border-bottom:1rpx solid #f5eee6}.center{text-align:center}.space{margin-top:24rpx}.error{color:#c46447;font-size:25rpx;margin:16rpx 0}.footer{text-align:center;font-size:21rpx;color:#aa9b8d;margin:35rpx 0;line-height:1.8}
