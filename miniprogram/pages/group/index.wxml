<view class="room-native">
  <view class="room-top"
    ><view class="room-title"
      >{{group.room.title || '红包群01'}}<text wx:if="{{group}}"
        >（{{group.room.memberCount}}）</text
      ></view
    ><view class="room-wallet"
      ><text class="coin-emblem">金</text
      ><text class="room-balance">{{group.user.balance || 0}}</text
      ><button class="room-withdraw" bindtap="wallet">提现</button></view
    ></view
  >
  <view class="room-mode"
    >开发联调 · 金币不可兑现 · 人数为注册账户数，非在线人数</view
  >
  <view wx:if="{{group}}" class="room-disclosure"
    >{{group.roomDisclosure}}</view
  >
  <view wx:if="{{error}}" class="room-error" bindtap="load"
    >{{error}} · 点击重试</view
  >
  <view wx:if="{{!group && !error}}" class="room-loading"
    >正在读取你的红包动态…</view
  >
  <view wx:if="{{group}}" class="room-stage">
    <scroll-view
      scroll-y="{{true}}"
      class="room-scroll"
      scroll-into-view="{{scrollTarget}}"
      bindscroll="onScroll"
    >
      <view class="room-messages">
        <view
          wx:for="{{rows}}"
          wx:key="id"
          class="room-message {{item.type === 'notice' ? 'room-announcement' : ''}}"
        >
          <image
            wx:if="{{item.avatar}}"
            class="room-avatar portrait-avatar"
            src="/assets/{{item.avatar}}.png"
            mode="aspectFill"
          /><view
            wx:else
            class="room-avatar avatar-{{item.type === 'packet' ? item.bank.kind : item.type}}"
            >{{item.mark}}</view
          >
          <view class="message-body"
            ><view class="message-head"
              ><view class="message-sender"
                ><text>{{item.actor}}</text
                ><text wx:if="{{item.badge}}" class="assistant-badge"
                  >{{item.badge}}</text
                ></view
              ><text class="message-time">{{item.time}}</text></view
            >
            <block wx:if="{{item.type === 'packet'}}">
              <view wx:if="{{item.bank.saved}}" class="chat-saved"
                ><view>已暂存 <text>{{item.bank.coins}}金币</text></view
                ><view class="saved-caption">金额保留，下一轮继续叠加。</view
                ><button
                  class="restore-button"
                  data-kind="{{item.bank.kind}}"
                  bindtap="restore"
                >
                  查看暂存{{item.bank.kind === 'redpacket' ? '红包' : '宝箱'}}
                </button></view
              >
              <view
                wx:else
                class="chat-packet {{item.bank.kind === 'treasure' ? 'is-treasure' : 'is-envelope'}} {{!item.bank.ready ? 'is-waiting' : ''}}"
              >
                <button
                  class="packet-open"
                  data-kind="{{item.bank.kind}}"
                  disabled="{{item.bank.disabled}}"
                  bindtap="claim"
                >
                  <view
                    wx:if="{{item.bank.kind === 'redpacket'}}"
                    class="packet-envelope"
                    ><view class="envelope-flap"></view
                    ><text class="envelope-seal">金</text></view
                  ><image
                    wx:else
                    src="/assets/{{item.bank.art}}.png"
                    mode="aspectFill"
                  /><view class="packet-copy"
                    ><view class="packet-greeting">{{item.bank.greeting}}</view
                    ><view class="packet-action">{{item.bank.action}}</view
                    ><view class="packet-value"
                      >{{item.bank.coins}}<text> 金币待领</text></view
                    ></view
                  >
                </button>
                <button
                  wx:if="{{item.bank.ready && !item.bank.locked}}"
                  class="packet-close"
                  data-kind="{{item.bank.kind}}"
                  catchtap="skip"
                >
                  ×
                </button>
                <view class="packet-bottom"
                  ><text
                    >{{item.bank.kind === 'redpacket' ? '金币红包' :
                    '金币宝箱'}} · 开发奖励</text
                  ><text>{{item.bank.timer}}</text></view
                ><view class="packet-track"
                  ><view style="width:{{item.bank.progress}}%"></view
                ></view>
              </view>
              <view class="packet-hint">{{item.bank.hint}}</view>
            </block>
            <view
              wx:elif="{{item.type === 'packet_history'}}"
              class="history-packet {{item.packetKind === 'treasure' ? 'history-treasure' : ''}}"
              ><image
                src="/assets/{{item.packetKind === 'treasure' ? 'chest' : 'packet'}}.png"
                mode="aspectFill"
              /><view
                ><view class="history-title">{{item.text}}</view
                ><view class="history-detail">{{item.detail}}</view></view
              ></view
            >
            <view wx:elif="{{item.type === 'ad'}}" class="chat-ad"
              ><view class="ad-art">广告位</view
              ><view class="ad-copy"
                ><view>{{item.text}}</view
                ><view class="ad-detail">{{item.detail}}</view
                ><view class="ad-label">开发占位 · 未接入</view></view
              ><button class="ad-close" bindtap="hideAd">×</button></view
            >
            <view
              wx:else
              class="message-bubble {{item.type === 'notice' ? 'notice-bubble' : ''}}"
              ><view>{{item.text}}</view
              ><view wx:if="{{item.coins}}" class="message-coins"
                >{{item.coins}}金币</view
              ><view wx:if="{{item.detail}}" class="message-detail"
                >{{item.detail}}</view
              ></view
            >
          </view>
        </view>
        <view id="room-end" class="room-end"
          >活动消息由运营方发布 · 金币以账户流水为准</view
        >
      </view>
    </scroll-view>
    <button class="lucky-float" bindtap="bag">
      <text class="lucky-tip">点击领奖</text
      ><image src="/assets/bag.png" mode="aspectFill" /><text
        class="lucky-label"
        >福袋</text
      >
    </button>
  </view>
  <view wx:if="{{adPreview.current.format === 'banner'}}" class="room-ad-banner"
    ><text class="banner-badge">横幅预览</text
    ><view class="banner-copy"
      ><view>等待期广告展示位置</view
      ><text>开发布局 · 无真实广告与收益</text></view
    ><button bindtap="hideAd" class="banner-close">×</button></view
  >
  <view class="room-tools"
    ><button bindtap="rules">玩法说明</button
    ><button wx:if="{{adPreview.enabled}}" bindtap="adSchedule">
      广告预览 {{adPreview.sessionCount}}/{{config.adPacing.sessionLimit}}</button
    ><button
      wx:if="{{group.user.pendingTask}}"
      bindtap="claim"
      data-kind="{{group.user.pendingTask.kind}}"
    >
      恢复未完成任务</button
    ><button wx:if="{{config.mode === 'development'}}" bindtap="advance">
      开发：推进一轮
    </button></view
  >
  <view
    wx:if="{{packetSheet}}"
    class="packet-overlay"
    catchtouchmove="blockTouch"
    catchtap="closePacket"
  >
    <view
      class="packet-sheet {{packetSheet.kind === 'treasure' ? 'treasure-reveal' : ''}} phase-{{packetSheet.phase}}"
      catchtap="blockTouch"
    >
      <view class="packet-flap"></view>
      <button
        class="packet-dismiss"
        catchtap="closePacket"
        disabled="{{packetSheet.phase === 'opening'}}"
        aria-label="关闭红包，保留已叠金币"
      >
        ×
      </button>
      <view class="packet-sender"
        ><image
          class="packet-avatar"
          src="/assets/{{packetSheet.avatar}}.png"
          mode="aspectFill"
        /><text class="packet-actor">{{packetSheet.actor}}</text
        ><text class="packet-caption"
          >活动助手发来的金币{{packetSheet.kind === 'treasure' ? '宝箱' :
          '红包'}}</text
        ></view
      >
      <view class="packet-sheet-title"
        >{{packetSheet.phase === 'received' ? '开发金币已入账' :
        packetSheet.phase === 'uncertain' ? '领取结果待确认' :
        packetSheet.greeting}}</view
      >
      <view class="packet-reward"
        ><text class="packet-total">{{packetSheet.total}}</text
        ><text class="packet-unit">金币</text
        ><text class="packet-state"
          >{{packetSheet.phase === 'received' ? '已领取 · 基础与补贴分别记账' :
          packetSheet.phase === 'opening' ? '3秒开发模拟中…' : packetSheet.phase
          === 'uncertain' ? '保留原任务，请查询结果' : '待领取'}}</text
        ></view
      >
      <view class="packet-breakdown"
        >基础{{packetSheet.base}} ＋
        补贴{{packetSheet.subsidy}}，合计{{packetSheet.total}}开发金币</view
      >
      <view
        wx:if="{{packetSheet.phase === 'uncertain'}}"
        class="packet-sheet-error"
        >{{packetSheet.error}}</view
      >
      <button
        wx:if="{{packetSheet.phase === 'ready' || packetSheet.phase === 'opening'}}"
        class="packet-seal"
        catchtap="openPacket"
        disabled="{{packetSheet.phase === 'opening'}}"
        aria-label="开，开始3秒开发模拟领取金币"
      >
        开
      </button>
      <button
        wx:elif="{{packetSheet.phase === 'received'}}"
        class="packet-receipt-done"
        catchtap="closePacket"
      >
        收下，继续叠包
      </button>
      <button
        wx:else
        class="packet-receipt-done"
        catchtap="retryPacket"
        disabled="{{busy}}"
      >
        查询原任务
      </button>
      <button
        wx:if="{{packetSheet.phase === 'ready'}}"
        class="packet-cancel"
        catchtap="closePacket"
      >
        暂不打开，保留已叠金币
      </button>
      <view class="packet-disclaimer"
        >{{packetSheet.phase === 'received' ? '本次奖励已记入金币流水。' :
        packetSheet.phase === 'uncertain' ?
        '网络异常时先查询原任务，不重复发奖。' :
        '点击「开」开始3秒开发模拟，无真实广告。'}}<view
          >金币不可兑现，不向微信付款。</view
        ></view
      >
    </view>
  </view>
</view>
