<view class="page">
  <view class="row"><view><view class="eyebrow">A LITTLE BETTER, EVERY DAY</view><view class="heading">今天，也值得期待</view></view><text class="pill">星享成长</text></view>
  <view class="notice">开发演示 · 广告无收益，金币不可兑现，转账不会进入微信零钱。</view>
  <view wx:if="{{error}}" class="error" bindtap="load">{{error}} · 点击重试</view>
  <view class="hero"><view class="row"><text>我的演示金币</text><text class="pill">成长账户</text></view><view class="balance">{{user.balance || 0}}</view><view class="muted">演示换算 ¥{{money || '0.00'}} · 不代表可兑现资金</view></view>
  <view class="stats"><view class="stat"><view class="stat-value">{{user.earnedToday || 0}}</view><view class="muted">今日奖励</view></view><view class="stat"><view class="stat-value">{{user.adsToday || 0}} / {{user.dailyLimit || 0}}</view><view class="muted">演示任务次数</view></view></view>
  <view class="card"><view class="row"><text class="title">每日签到</text><text class="pill">＋{{config.checkinCoins}} 金币</text></view><view class="muted">签到免费完成，坚持从一件小事开始</view><view class="week"><view class="day" wx:for="{{user.week}}" wx:key="day"><view class="day-coin {{item.signed ? 'active' : ''}}">{{item.signed ? '✓' : '✦'}}</view><text>{{item.label}}</text></view></view><button class="button" disabled="{{busy || user.signedToday}}" bindtap="checkin">{{user.signedToday ? '今日已签到' : '签到领取金币'}}</button><button wx:if="{{user.signedToday && config.adProvider === 'demo'}}" class="button light" disabled="{{busy}}" bindtap="bonus">可选：演示广告加奖</button></view>
  <view class="card"><view class="row"><text class="title">今日小计划</text><text class="muted">为自己积累一点成就</text></view><view wx:for="{{plans}}" wx:key="id" class="plan"><view class="check {{item.done ? 'done' : ''}}" data-id="{{item.id}}" bindtap="toggle">{{item.done ? '✓' : ''}}</view><text class="plan-text {{item.done ? 'done' : ''}}" data-id="{{item.id}}" bindtap="toggle">{{item.title}}</text><text class="delete" data-id="{{item.id}}" bindtap="remove">×</text></view><input class="plan-input" value="{{draft}}" bindinput="input" placeholder="添加一件今天想完成的小事" maxlength="60" bindconfirm="addPlan"/><button class="button secondary" disabled="{{busy || !draft}}" bindtap="addPlan">添加计划</button></view>
  <button class="button light" bindtap="chests">去宝箱广场看看 →</button><view class="footer">星享成长 · 让日常多一点小成就</view>
</view>
