<view class="page"
  ><view class="heading">每一笔都有记录</view
  ><view class="notice">全部为开发演示账务，不代表真实收入。</view
  ><view class="error" wx:if="{{error}}" bindtap="load"
    >{{error}} · 点击重试</view
  ><view class="card"
    ><view wx:if="{{!records.length}}" class="muted">暂无记录</view
    ><view wx:for="{{records}}" wx:key="id" class="list-item"
      ><view class="row"
        ><text>{{item.title}}</text
        ><text class="amount {{item.isMinus ? 'minus' : ''}}"
          >{{item.delta}} 金币</text
        ></view
      ><view class="muted">{{item.time}}</view
      ><view wx:if="{{item.frozen_delta}}" class="muted"
        >冻结变动 {{item.frozen_delta}} 金币</view
      ></view
    ></view
  ></view
>
