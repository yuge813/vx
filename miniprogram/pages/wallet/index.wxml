<view class="page"
  ><view class="eyebrow">EVERY LITTLE REWARD COUNTS</view
  ><view class="heading">我的钱包</view
  ><view class="notice"
    >本页仅演示提现申请与审核流程。金币不可兑现，不会进入微信零钱。</view
  ><view class="error" wx:if="{{error}}" bindtap="load"
    >{{error}} · 点击重试</view
  ><view class="hero"
    ><view class="row"
      ><text>演示可用金额</text><text class="pill">非真实资金</text></view
    ><view class="balance">¥ {{balance || '0.00'}}</view
    ><view class="muted"
      >{{user.balance || 0}} 金币 · {{config.coinsPerYuan || 1000}}
      金币演示换算1元</view
    ></view
  ><view class="stats"
    ><view class="stat"
      ><view class="stat-value">¥{{frozen || '0.00'}}</view
      ><view class="muted">申请冻结中</view></view
    ><view class="stat"
      ><view class="stat-value">¥{{paid || '0.00'}}</view
      ><view class="muted">模拟完成金额</view></view
    ></view
  >
  <view class="card"
    ><view class="title">演示提现申请</view
    ><view class="muted"
      >最低{{config.minimumWithdrawalCoins ||
      1000}}金币。提交后先冻结，驳回退回；真实提现尚未接入。</view
    ><input
      class="plan-input"
      type="number"
      value="{{coins}}"
      bindinput="input"
      placeholder="输入金币数量"
    /><view class="row space"
      ><text class="muted">演示换算</text
      ><text class="title">¥{{amount}}</text></view
    ><button
      class="button"
      disabled="{{busy || !config.demoTransfersEnabled}}"
      bindtap="withdraw"
    >
      {{busy ? '正在提交…' : config.demoTransfersEnabled ? '提交演示申请' :
      '真实提现尚未开放'}}</button
    ><button class="button light" bindtap="records">
      查看金币流水 →
    </button></view
  >
  <view class="card"
    ><view class="title">申请记录</view
    ><view wx:if="{{!orders.length}}" class="muted space">还没有申请记录</view
    ><view wx:for="{{orders}}" wx:key="id" class="list-item"
      ><view class="row"
        ><text>¥{{item.amount}}</text
        ><text class="pill">{{item.label}}</text></view
      ><view class="muted">{{item.time}}</view
      ><view wx:if="{{item.reason}}" class="muted"
        >处理说明：{{item.reason}}</view
      ></view
    ></view
  >
</view>
