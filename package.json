{
  "name": "yuanxiang-style-miniapp",
  "version": "0.5.0",
  "private": true,
  "description": "悦享整合体验版：每日趣答、数字合成、记忆翻牌、红包群及运营后台",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "node --env-file-if-exists=.env.yuanxiang server/index.mjs",
    "dev": "node --env-file-if-exists=.env.yuanxiang --watch server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "doctor": "node --env-file-if-exists=.env.yuanxiang scripts/doctor.mjs",
    "backup": "node --env-file-if-exists=.env.yuanxiang scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "release": "node scripts/release.mjs",
    "verify": "npm test && npm run check",
    "test:ops-browser": "node scripts/ops-browser-smoke.mjs",
    "test:packet-ui": "node scripts/packet-ui-smoke.mjs",
    "test:play-browser": "node scripts/play-browser-smoke.mjs",
    "test:play-admin": "node scripts/play-admin-smoke.mjs",
    "test:play-container": "node scripts/play-container-smoke.mjs",
    "test:container": "node scripts/container-smoke.mjs",
    "configure:mini": "node scripts/configure-mini.mjs"
  }
}
